PORT=3001
FRONTEND_URL=http://localhost:3020

# Optional — when unset, rate limiting uses in-memory store (fine for local dev)
REDIS_URL=

# Optional webhook URLs (future use via job queue)
CONTACT_WEBHOOK_URL=
APPLY_WEBHOOK_URL=

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
# Optional direct Postgres URL (otherwise derived from project URL + password)
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

NEXT_PUBLIC_SITE_URL=http://localhost:3020

# Bootstrap admin (used by npm run db:migrate)
ADMIN_EMAIL=admin@seedqura.com
ADMIN_PASSWORD=SeedquraAdmin@123

# --- Razorpay ----------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Mail (Gmail App Password) ------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Seedqura <hello@seedqura.in>
MAIL_TO=hello@seedqura.in
